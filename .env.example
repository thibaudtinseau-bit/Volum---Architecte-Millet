# URL publique du site (pour les balises canoniques, le sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://volum-architecte-millet.vercel.app
# E-mail affiché sur le site (facultatif)
NEXT_PUBLIC_CONTACT_EMAIL=

# Formulaire de contact — option A : Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_EMAIL=
RESEND_FROM=
# Formulaire de contact — option B : Formspree (https://formspree.io)
FORMSPREE_ENDPOINT=

# Avis Google en direct (facultatif) — clé « Places API (New) »
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
