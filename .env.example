# URL publique du site (pour les balises canoniques, le sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://volum-architecte-millet.vercel.app
# E-mail affiché sur le site (facultatif)
NEXT_PUBLIC_CONTACT_EMAIL=

# Formulaire de contact — destinataires (séparés par des virgules)
CONTACT_EMAIL=
# Option A (recommandée) : Gmail — SMTP_USER = adresse Gmail, SMTP_PASS = mot de passe d'application
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
# Option B : Resend (https://resend.com) — nécessite un domaine vérifié pour plusieurs destinataires
RESEND_API_KEY=
RESEND_FROM=
# Option C : Formspree (https://formspree.io)
FORMSPREE_ENDPOINT=

# Avis Google en direct (facultatif) — clé « Places API (New) »
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
